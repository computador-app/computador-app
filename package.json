{
  "name": "computador-app",
  "productName": "Computador",
  "description": "Harness desktop para agentes, construído com Electron, React e TypeScript.",
  "author": "Computador contributors",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "npm run build:backend && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node electron/dev-launcher.cjs\"",
    "build": "npm run build:backend && tsc --noEmit && vite build",
    "start": "node electron/dev-launcher.cjs",
    "test": "npm run build:backend && vitest run && node --test electron/*.test.cjs tests/backend/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e",
    "test:electron": "npm run build && node tests/electron-smoke.mjs && node tests/electron-phase2.mjs && node tests/electron-agents.mjs",
    "build:backend": "tsc -p tsconfig.backend.json",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.0.1",
    "dockview": "^8.4.0",
    "dockview-react": "^8.4.0",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "build": {
    "appId": "app.computador.desktop",
    "productName": "Computador",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/**/*.cjs"
    ],
    "mac": {
      "target": "dmg",
      "icon": "assets/computador.icns",
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/computador-icon.png",
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "icon": "assets/computador-icon.png",
      "category": "Development",
      "synopsis": "Harness desktop para agentes",
      "maintainer": "Computador contributors",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  }
}
